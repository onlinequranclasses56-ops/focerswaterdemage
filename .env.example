# ── Vercel Environment Variables ──────────────────────────────────────────────
# Copy this file to .env.local for local dev.
# Set these in Vercel UI → Project → Settings → Environment Variables.

# Production canonical URL — must match your custom domain exactly.
NEXT_PUBLIC_SITE_URL=https://www.force1waterdamagefl.com

# Secures the /api/ping weekly cron route from unauthorized access.
# Set to any random 32+ character string — generate one at https://csprng.xyz
CRON_SECRET=replace-with-a-random-secret-string
